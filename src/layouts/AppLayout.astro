---
import Layout from './Layout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  activeRoute?: string;
}

const { 
  title = "Universal Billing · PayzenMax", 
  activeRoute = "dashboard" 
} = Astro.props;

const navItems = [
  { href: '/dashboard', id: 'dashboard', label: 'Dashboard', icon: 'dashboard' },
  { href: '/invoices', id: 'invoices', label: 'Invoices', icon: 'receipt' },
  { href: '/credit-notes', id: 'credit_notes', label: 'Credit notes', icon: 'file-text' },
  { href: '/customers', id: 'customers', label: 'Customers', icon: 'users' },
  { href: '/inventory', id: 'inventory', label: 'Items & stock', icon: 'package' },
];

const reportItems = [
  { href: '/gstr1', id: 'gstr1', label: 'GSTR-1 Return', icon: 'spreadsheet' },
  { href: '/gst-tools', id: 'gst_tools', label: 'GST Toolkit (Offline)', icon: 'wrench' },
  { href: '/invoices', id: 'sales_register', label: 'Sales register', icon: 'book' },
  { href: '/receivables', id: 'receivables', label: 'Receivables aging', icon: 'clock' },
];
---

<Layout title={title}>
  <div class="flex h-screen overflow-hidden">
    <!-- Desktop & Mobile Sidebar Drawer -->
    <aside 
      id="sidebar-drawer" 
      class="fixed lg:static top-0 bottom-0 left-0 z-50 w-64 bg-white/95 dark:bg-slate-900/95 backdrop-blur-xl border-r border-slate-200/90 dark:border-slate-800/80 flex flex-col h-full select-none shrink-0 transition-transform duration-300 -translate-x-full lg:translate-x-0 shadow-xl lg:shadow-none"
    >
      <!-- Top Home Return Banner (Direct Access to Landing) -->
      <div class="px-3 pt-3">
        <a
          href="/"
          class="w-full flex items-center justify-between px-3 py-2 text-xs font-semibold rounded-xl text-emerald-800 dark:text-emerald-300 bg-emerald-50/90 dark:bg-emerald-950/40 border border-emerald-200/90 dark:border-emerald-800/50 hover:bg-emerald-100/80 dark:hover:bg-emerald-900/40 hover:border-emerald-300 dark:hover:border-emerald-700 transition group shadow-2xs"
          title="Return to Home Landing Page"
        >
          <span class="flex items-center gap-2">
            <span class="p-1 rounded bg-white dark:bg-slate-900 text-emerald-700 dark:text-emerald-400 group-hover:-translate-x-0.5 transition-transform shadow-xs">
              ←
            </span>
            <span class="font-bold">Home Page</span>
          </span>
          <span class="text-[10px] uppercase font-mono tracking-wider opacity-70 group-hover:opacity-100 transition">
            Exit
          </span>
        </a>
      </div>

      <!-- Brand Header -->
      <div class="p-4 border-b border-slate-100 dark:border-slate-800/70 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group overflow-hidden">
          <div class="w-8 h-8 rounded-lg bg-emerald-700 dark:bg-emerald-600 flex items-center justify-center text-white font-bold text-xs tracking-wider shadow-sm group-hover:bg-emerald-800 transition shrink-0">
            PM
          </div>
          <div class="overflow-hidden">
            <h1 class="font-bold text-sm tracking-tight text-slate-900 dark:text-white truncate group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition">
              PayzenMax.com
            </h1>
            <p className="text-[11px] text-slate-500 dark:text-slate-400 truncate font-medium">Universal Billing</p>
          </div>
        </a>

        <div class="flex items-center gap-1">
          <ThemeToggle className="scale-90" />
          <button 
            id="close-sidebar-btn" 
            class="lg:hidden p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition"
          >
            ✕
          </button>
        </div>
      </div>

      <!-- Tax Jurisdiction Badge -->
      <div class="px-4 py-2 bg-slate-50/80 dark:bg-slate-800/40 border-b border-slate-100 dark:border-slate-800/60 text-[11px] text-slate-500 dark:text-slate-400 space-y-0.5">
        <div class="font-mono text-slate-700 dark:text-slate-300 font-semibold truncate">
          GSTIN: 27AAJCV4821M1Z6
        </div>
        <div class="truncate text-slate-500 dark:text-slate-400 text-[10px]">
          Maharashtra (27) · FY 2026-27
        </div>
      </div>

      <!-- New Bill Primary CTA -->
      <div class="p-3">
        <a
          href="/new-bill"
          class="w-full flex items-center justify-between px-3.5 py-2.5 bg-gradient-to-r from-emerald-700 to-emerald-800 hover:from-emerald-800 hover:to-emerald-900 text-white font-semibold text-sm rounded-xl shadow-md hover:shadow-lg dark:shadow-emerald-950/40 transition active:scale-[0.98] border border-emerald-600/30"
        >
          <span class="flex items-center gap-2">
            <span>+</span>
            <span>New bill</span>
          </span>
          <kbd class="text-[10px] bg-emerald-950/50 text-emerald-100 px-1.5 py-0.5 rounded font-mono font-bold border border-emerald-500/20">
            Alt+N
          </kbd>
        </a>
      </div>

      <!-- Nav Links -->
      <div class="flex-1 overflow-y-auto px-2 space-y-5 py-2">
        <div>
          <div class="px-3 pb-1 text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-500 uppercase">
            Operations
          </div>
          <div class="space-y-0.5">
            {navItems.map(item => {
              const isActive = activeRoute === item.id;
              return (
                <a
                  href={item.href}
                  class={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition ${
                    isActive
                      ? 'bg-emerald-50/90 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/40 shadow-2xs'
                      : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'
                  }`}
                >
                  <span class="truncate">{item.label}</span>
                </a>
              );
            })}
          </div>
        </div>

        <div>
          <div class="px-3 pb-1 text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-500 uppercase">
            Reports & Tax
          </div>
          <div class="space-y-0.5">
            {reportItems.map(item => {
              const isActive = activeRoute === item.id;
              return (
                <a
                  href={item.href}
                  class={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition ${
                    isActive
                      ? 'bg-emerald-50/90 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/40 shadow-2xs'
                      : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'
                  }`}
                >
                  <span class="truncate">{item.label}</span>
                </a>
              );
            })}
          </div>
        </div>

        <div>
          <div class="px-3 pb-1 text-[10px] font-bold tracking-wider text-slate-400 dark:text-slate-500 uppercase">
            System
          </div>
          <a
            href="/settings"
            class={`w-full flex items-center justify-between px-3 py-2 rounded-xl text-xs font-semibold transition ${
              activeRoute === 'settings'
                ? 'bg-emerald-50/90 text-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-300 border border-emerald-200/80 dark:border-emerald-800/40 shadow-2xs'
                : 'text-slate-600 dark:text-slate-300 hover:bg-slate-100/70 dark:hover:bg-slate-800/60 hover:text-slate-900 dark:hover:text-white'
            }`}
          >
            <span>Settings & backup</span>
          </a>
        </div>
      </div>

      <!-- Offline Status Badge -->
      <div class="p-3 border-t border-slate-100 dark:border-slate-800/80 bg-slate-50/70 dark:bg-slate-900/80 space-y-2">
        <a
          href="/"
          class="w-full flex items-center justify-between px-2.5 py-1.5 text-xs text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white hover:bg-slate-200/60 dark:hover:bg-slate-800/60 rounded-lg font-semibold transition group"
        >
          <span class="flex items-center gap-2">
            <span class="text-emerald-600 dark:text-emerald-400 group-hover:-translate-x-0.5 transition-transform font-bold">←</span>
            <span>Back to Home</span>
          </span>
          <span class="text-[10px] text-slate-400">Exit</span>
        </a>
        <div class="flex items-center gap-1.5 text-[11px] text-slate-500 dark:text-slate-400 font-medium px-1">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="truncate">Saved on device · Offline ready</span>
        </div>
      </div>
    </aside>

    <!-- Main Workspace Content Container -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">
      <!-- Mobile Top Header -->
      <header class="lg:hidden bg-white/95 dark:bg-slate-900/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 py-2.5 flex items-center justify-between z-30 shrink-0">
        <div class="flex items-center gap-2">
          <button
            id="open-sidebar-btn"
            class="p-1.5 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition"
            title="Open navigation menu"
          >
            ☰
          </button>
          
          <a
            href="/"
            class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-semibold text-emerald-800 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200/80 dark:border-emerald-800/60 hover:bg-emerald-100 transition group shadow-2xs"
            title="Return to Home Landing Page"
          >
            <span class="text-emerald-600 dark:text-emerald-400 font-bold group-hover:-translate-x-0.5 transition-transform">←</span>
            <span class="font-bold">Home</span>
          </a>
        </div>

        <div class="flex items-center gap-2">
          <ThemeToggle className="scale-90" />
          <a
            href="/new-bill"
            class="flex items-center gap-1 px-2.5 py-1.5 bg-gradient-to-r from-emerald-700 to-emerald-800 text-white text-xs font-semibold rounded-lg shadow-xs active:scale-95 transition"
          >
            <span>+</span>
            <span>New bill</span>
          </a>
        </div>
      </header>

      <!-- Desktop Top Workspace Bar -->
      <header class="hidden lg:flex items-center justify-between px-6 py-2.5 bg-white/80 dark:bg-slate-900/80 backdrop-blur-md border-b border-slate-200/80 dark:border-slate-800/80 z-20 shrink-0">
        <!-- Left: Home Return Button & Breadcrumbs -->
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-semibold text-slate-700 dark:text-slate-200 bg-slate-50 dark:bg-slate-800/70 border border-slate-200/90 dark:border-slate-700/80 hover:bg-emerald-50 dark:hover:bg-emerald-950/40 hover:border-emerald-300 dark:hover:border-emerald-700/80 hover:text-emerald-700 dark:hover:text-emerald-300 transition group shadow-2xs"
            title="Return to PayzenMax Landing Page"
          >
            <span class="text-emerald-600 dark:text-emerald-400 font-bold text-sm group-hover:-translate-x-1 transition-transform">←</span>
            <span class="font-bold">Back to Home</span>
          </a>

          <div class="flex items-center gap-2 text-xs text-slate-400 dark:text-slate-500 font-medium">
            <span>PayzenMax</span>
            <span>/</span>
            <span class="text-slate-700 dark:text-slate-200 font-semibold capitalize">
              {activeRoute.replace('_', ' ')}
            </span>
          </div>
        </div>

        <!-- Right: Offline Status & Fast Actions -->
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-400 border border-emerald-200/80 dark:border-emerald-800/60 shadow-2xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>100% Offline Ready</span>
          </div>

          <div class="h-4 w-px bg-slate-200 dark:bg-slate-800"></div>

          <a
            href="/new-bill"
            class="flex items-center gap-1.5 px-3.5 py-1.5 bg-gradient-to-r from-emerald-700 to-emerald-800 hover:from-emerald-800 hover:to-emerald-900 text-white text-xs font-semibold rounded-xl shadow-xs hover:shadow-sm transition active:scale-95"
          >
            <span>+ New bill</span>
            <kbd class="text-[10px] bg-emerald-950/50 text-emerald-100 px-1 py-0.2 rounded font-mono ml-0.5">Alt+N</kbd>
          </a>
        </div>
      </header>

      <!-- Scrollable Main View Slot -->
      <main class="flex-1 overflow-y-auto">
        <slot />
      </main>
    </div>
  </div>

  <!-- Mobile Drawer Toggle Script -->
  <script is:inline>
    const drawer = document.getElementById('sidebar-drawer');
    const openBtn = document.getElementById('open-sidebar-btn');
    const closeBtn = document.getElementById('close-sidebar-btn');

    if (openBtn && drawer) {
      openBtn.addEventListener('click', () => {
        drawer.classList.remove('-translate-x-full');
      });
    }
    if (closeBtn && drawer) {
      closeBtn.addEventListener('click', () => {
        drawer.classList.add('-translate-x-full');
      });
    }
  </script>
</Layout>
